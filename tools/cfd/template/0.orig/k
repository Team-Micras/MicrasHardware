FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1;
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    "(inlet|ambient)" { type inletOutlet; inletValue uniform 1e-4; value uniform 1e-4; }
    "(floor|board|impeller|mount|motor)" { type kqRWallFunction; value uniform 1e-4; }
}
